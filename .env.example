# 로컬 개발 기본값. 실제 값은 .env에 (커밋 금지)
# 접근은 반드시 src/config/env.ts를 통해서만 (docs/SSOT.md)
DATABASE_URL=postgres://postgres:postgres@localhost:5433/songgalaxy
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
AUTH_SECRET=
# 선택: 곡 상세의 YouTube 영상 임베드용 (없으면 검색 링크 폴백)
# https://console.cloud.google.com/apis/credentials 에서 API 키 발급 후 YouTube Data API v3 활성화
YOUTUBE_API_KEY=
